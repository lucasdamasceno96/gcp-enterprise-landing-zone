# ==========================================
# Terraform Specific
# ==========================================
# Local .terraform directories (provider binaries and modules)
**/.terraform/*

# .tfstate files (Contains sensitive data in plain text!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files by default
# These often contain passwords, service account keys, or sensitive IPs
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ==========================================
# Secrets and Environment Variables
# ==========================================
# Environmental variables
.env
.env.local
.env.*.local
.env.production
.env.development

# Google Cloud Service Account Keys (JSON)
# Never commit these! Use Workload Identity Federation instead.
*.json
!**/*.tfvars.json

# Certificates and private keys
*.pem
*.key
*.pub

# ==========================================
# Operating System & Editors
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / JetBrains
.idea/

# ==========================================
# Logs and Temp
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/